    </widget>
   </item>
   <item>
    <widget class="QWidget" name="settings" native="true">
     <layout class="QFormLayout" name="form">
      <item row="0" column="0">
       <widget class="QLabel" name="form_operation_2_label">
        <property name="text">
         <string>Operation</string>
        </property>
