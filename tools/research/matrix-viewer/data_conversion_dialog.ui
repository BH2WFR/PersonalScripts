        <property name="text">
         <string>Input range</string>
        </property>
        <property name="buddy">
         <cstring>range_selector</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="NoWheelComboBox" name="range_selector" />
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="full_complex">
        <property name="text">
         <string>Use full complex values (instead of selected component)</string>
        </property>
        <property name="toolTip">
         <string>Full complex input offers amplitude dB, magnitude and scale/offset. Uncheck to convert the displayed real channel.</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="bounds">
        <property name="text">
         <string>Apply current value bounds before conversion</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="form_db_reference_label">
        <property name="text">
