      <property name="rightMargin">
       <number>0</number>
      </property>
      <property name="bottomMargin">
       <number>0</number>
      </property>
     </layout>
    </widget>
   </item>
   <item row="3" column="0">
    <widget class="QLabel" name="field_1d_nonfinite_marker_size_label">
     <property name="text">
      <string>1D nonfinite marker size</string>
     </property>
     <property name="buddy">
      <cstring>nonfinite_size</cstring>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="NoWheelDoubleSpinBox" name="nonfinite_size">
     <property name="toolTip">
      <string>Inf / -Inf / NaN dot diameter in 1D plots, including slices. 2D retains whole-pixel coloring.</string>
     </property>
    </widget>
   </item>
   <item row="4" column="0" colspan="2">
    <widget class="QLabel" name="marker_hint">
     <property name="text">
      <string>1D: Inf at the finite maximum, -Inf at the minimum, NaN at zero. 2D: color the original pixel. Derivatives exclude these samples.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
  </layout>
  <property name="title">
   <string>Value markers</string>
