<ui version="4.0">
 <class>ValueMarkers</class>
 <widget class="QGroupBox" name="ValueMarkers">
  <layout class="QFormLayout" name="markers">
   <item row="0" column="0" colspan="2">
    <layout class="QHBoxLayout" name="highlight_row">
     <item>
      <widget class="QCheckBox" name="highlight_clipped">
       <property name="text">
        <string>Highlight clipped values</string>
       </property>
       <property name="toolTip">
        <string>Emphasize clamped samples in 1D, 2D and 3D. Turning this off keeps value clamping active.</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="clip_color_button">
       <property name="text">
        <string>Clipping color</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item row="1" column="0" colspan="2">
    <widget class="QCheckBox" name="show_nonfinite">
     <property name="text">
      <string>Show Inf / -Inf / NaN markers (1D / 2D)</string>
     </property>
     <property name="toolTip">
      <string>1D: Inf at the visible finite maximum, -Inf at the minimum, NaN at zero. No finite samples: use zero. 2D: color the original pixel. Source values and derivatives are unchanged.</string>
     </property>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <widget class="QWidget" name="nonfinite_color_row" native="true">
