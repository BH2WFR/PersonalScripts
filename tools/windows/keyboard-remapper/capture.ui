  <layout class="QVBoxLayout" name="main_layout">
   <item>
    <widget class="QLabel" name="explanation">
     <property name="text">
      <string>Keep this window focused and press ONE key, including a modifier.
Capture stops after one key or 20 seconds. Use the mouse to confirm/cancel.

Already remapped keys may report their destination. Select the original
key from the list instead. Disabled keys, Fn and system-reserved keys
may not reach this window. System shortcuts are not blocked.</string>
     </property>
